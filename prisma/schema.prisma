generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  password        String
  name            String?
  role            UserRole         @default(CUSTOMER)
  supplierProfile SupplierProfile?
  products        Product[]
  cart            CartItem[]
  orders          Order[]
  subscriptions   Subscription[]
  supportTickets  SupportTicket[]
  ratings         Rating[]
  wishlist        Wishlist[]
  addresses       Address[]
  paymentMethods  PaymentMethod[]
  refreshTokens   RefreshToken[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([email])
}

enum UserRole {
  CUSTOMER
  SUPPLIER
  ADMIN
}

model SupplierProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName        String
  description      String?
  logo             String? 
  banner           String? 
  website          String?
  rating           Float     @default(5.0)
  totalReviews     Int       @default(0)
  totalSales       Int       @default(0)
  isVerified       Boolean   @default(false)
  verificationDate DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Product {
  id         String @id @default(cuid())
  supplierId String

  supplier   User        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  name        String
  description String
  images      String[]
  basePrice   Float

  stock   Int
  inStock Boolean @default(true)
  sku     String? @unique

  meatType     MeatType
  preparations String[]

  isNewArrival    Boolean @default(false)
  isBestSeller    Boolean @default(false)
  sameDayDelivery Boolean @default(false)

  category String
  tags     String[]

  tiers    ProductTier[]
  variants ProductVariant[]

  rating      Float    @default(5.0)
  reviewCount Int      @default(0)
  ratings     Rating[]
  wishlistedBy Wishlist[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([category])
  @@index([meatType])
}

enum MeatType {
  BEEF
  CHICKEN
  SEAFOOD
  GOAT
  PORK
  TURKEY
  BBQ
  SAUSAGE
  SPICE
}

model ProductTier {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name            String // "Basic", "Professional", "Enterprise"
  description     String?
  price           Float
  discount        Float? // Percentage discount for bulk
  minimumQuantity Int      @default(1)
  features        String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name          String // "Red", "Large", etc
  value         String
  priceModifier Float  @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
}

model CartItem {
  id String @id @default(cuid())
  userId    String
  productId String
  quantity Int @default(1)
  selectedTier        String?
  selectedPreparation String?
  selectedVariants Json?
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Order {
  id         String @id @default(cuid())
  customerId String
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items OrderItem[]
  subtotal Float
  tax      Float @default(0)
  shipping Float @default(0)
  total    Float
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   String?
paystackReference String? @unique
  shippingAddress String
  shippingCity    String
  shippingState   String
  shippingZip     String
  shippingCountry String
  trackingNumber    String?
  estimatedDelivery DateTime?
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  updatedAt   DateTime  @updatedAt
  @@index([customerId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Int
  pricePerUnit Float
  tier         String?
  variants     Json?
  createdAt DateTime @default(now())
  @@index([orderId])
  @@index([productId])
}


model Subscription {
  id         String @id @default(cuid())
  customerId String
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type SubscriptionType
  tier String // Which tier (Basic, Pro, etc)

  price        Float
  billingCycle Int // Days

  status               SubscriptionStatus @default(ACTIVE)
paystackSubscriptionCode String?

  nextBillingDate DateTime
  cancelledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

enum SubscriptionType {
  MONTHLY_DELIVERY
  QUARTERLY_DELIVERY
  ANNUAL_DELIVERY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

// Support tickets
model SupportTicket {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject     String
  description String
  category    String

  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(MEDIUM)

  messages TicketMessage[]

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}


model TicketMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String
  message     String
  attachments String[]
  createdAt DateTime @default(now())
  @@index([ticketId])
}

model Rating {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  score   Int     @db.SmallInt 
  title   String?
  comment String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
}


model RefreshToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}

model AnalyticsEvent {
  id        String  @id @default(cuid())
  eventType String // "product_view", "add_to_cart", "purchase", etc
  userId    String?
  productId String?
  metadata String // JSON string for extra data
  createdAt DateTime @default(now())
  @@index([eventType])
  @@index([userId])
  @@index([productId])
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  image       String? // Supabase URL
  slug        String  @unique
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryLog {
  id        String @id @default(cuid())
  productId String
  previousStock Int
  newStock      Int
  changeReason  InventoryChangeReason
  notes         String?
  createdAt DateTime @default(now())
  @@index([productId])
}

enum InventoryChangeReason {
  PURCHASE
  RESTOCK
  ADJUSTMENT
  DAMAGE
  EXPIRY
  RETURN
}

model Promotion {
  id          String  @id @default(cuid())
  code        String  @unique
  description String?
  type  PromotionType // PERCENTAGE, FIXED_AMOUNT
  value Float // 10 for 10%, or 5 for $5 off
  startDate      DateTime
  endDate        DateTime
  maxUses        Int?
  currentUses    Int      @default(0)
  minOrderAmount Float?
  applicableProducts  String[] // Product IDs
  applicableMeatTypes String[] // MeatType values
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([code])
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model DeliveryZone {
  id       String   @id @default(cuid())
  name     String
  zipCodes String[] // Delivery zones by zip code range
  state    String?
  baseCost         Float
  freeDeliveryOver Float? // Free delivery for orders over this amount
  estimatedDays    Int // Estimated delivery days
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  label    String? // "Home", "Office", etc
  fullName String
  phone    String?
  street   String
  city     String
  state    String
  zipCode  String
  country  String  @default("USA")
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}


model PaymentMethod {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type  PaymentMethodType // CARD, BANK_TRANSFER, DIGITAL_WALLET
  label String? // "Visa ending in 4242"
  cardLast4  String?
  cardBrand  String? // visa, mastercard, verve
  cardExpiry String? // MM/YY, derived from exp_month/exp_year
  paystackAuthorizationCode String? @unique
  paystackCustomerCode String?

  bankName          String? // for BANK_TRANSFER type
  bankAccountLast4  String?

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([paystackCustomerCode])
}

enum PaymentMethodType {
  CARD
  BANK_TRANSFER
  DIGITAL_WALLET
}

